# Java properties format: no export and no surrounding quotes.
DB_URL=jdbc:postgresql://localhost:5432/ugk_schedule
DB_USERNAME=ugk_schedule
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
MINIAPP_URL=https://schedule.example.com/miniapp/schedule
TELEGRAM_BOT_TOKEN=
MAX_BOT_TOKEN=
MINIAPP_REQUEST_LOGGING=false
APP_LOG_DIR=/var/log/ugk-schedule
APP_LOG_MAX_FILE_SIZE=10MB
# 0 keeps archives indefinitely; set a number of days to enable automatic cleanup.
APP_LOG_HISTORY_DAYS=0
